---
source: tests/schema.rs
expression: "stdout(&[\"schema\", \"get\"])"
---
{
  "$defs": {
    "SectionOut": {
      "description": "A section as it appears in the JSON envelope.",
      "properties": {
        "body": {
          "description": "Section source markdown.",
          "type": "string"
        },
        "heading": {
          "description": "Heading text.",
          "type": "string"
        },
        "level": {
          "description": "Heading depth, 1–6.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "line": {
          "description": "1-based source line of the heading.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "slug": {
          "description": "Slugified heading.",
          "type": "string"
        }
      },
      "required": [
        "heading",
        "slug",
        "level",
        "line",
        "body"
      ],
      "type": "object"
    },
    "TrustEvent": {
      "description": "One `{by, at}` event, with both fields as written.",
      "properties": {
        "at": {
          "description": "The timestamp exactly as written in the frontmatter.",
          "type": [
            "string",
            "null"
          ]
        },
        "by": {
          "description": "The actor, in the §7 convention (`human:mike`, `agent:okq@0.6`).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "TrustEvents": {
      "description": "The evidence behind a derived trust tier: who produced the content and who\nhas confirmed it. Reported so the derivation is auditable rather than magic\n(ADR-0014).",
      "properties": {
        "generated": {
          "anyOf": [
            {
              "$ref": "#/$defs/TrustEvent"
            },
            {
              "type": "null"
            }
          ],
          "description": "`generated: {by, at}` — who wrote the current content, and when."
        },
        "verified": {
          "description": "`verified: [{by, at}]` — every confirmation, in frontmatter order.",
          "items": {
            "$ref": "#/$defs/TrustEvent"
          },
          "type": "array"
        }
      },
      "required": [
        "verified"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The JSON envelope for `okq get`. The `id`/`type`/`title`/`path`/`line`\nfields are the shared concept envelope reused by other commands' shortlists.",
  "properties": {
    "body": {
      "description": "Full body markdown. Omitted unless requested.",
      "type": [
        "string",
        "null"
      ]
    },
    "frontmatter": {
      "description": "Frontmatter (well-known keys + producer extensions), narrowed to the one\nkey named by `--field` if given. Omitted unless requested."
    },
    "id": {
      "description": "The concept id (path minus `.md`).",
      "type": "string"
    },
    "line": {
      "description": "1-based line where the concept begins (always 1).",
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "path": {
      "description": "The concept's path relative to the bundle root.",
      "type": "string"
    },
    "provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/TrustEvents"
        },
        {
          "type": "null"
        }
      ],
      "description": "The `generated` and `verified` events the trust tier was derived from.\nOmitted when the concept carries neither."
    },
    "schema": {
      "description": "Schema tag (`okq.get/v1`).",
      "type": "string"
    },
    "sections": {
      "description": "The selected section(s). Present only with `--section`.",
      "items": {
        "$ref": "#/$defs/SectionOut"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "stale": {
      "description": "`true` when `stale_after` has passed, omitted otherwise. Evaluated\nagainst `--today` when given, else the system date.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "status": {
      "description": "Lifecycle `status`, omitted when `stable` (the default when the key is\nabsent). A producer-defined value outside draft/stable/deprecated is\nreported verbatim — §5.4 requires consumers to tolerate it.",
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "description": "The concept's title: the frontmatter `title`, or the filename if none.",
      "type": "string"
    },
    "trust": {
      "description": "Derived trust tier, omitted when `unverified` (the default when there is\nno `verified` key). Never stored in frontmatter: it is computed from the\n`verified` actors — any `human:` verifier yields `human-reviewed`,\nnon-human verifiers alone yield `machine-confirmed`.",
      "type": [
        "string",
        "null"
      ]
    },
    "type": {
      "description": "The frontmatter `type`, if present.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema",
    "id",
    "path",
    "line",
    "title"
  ],
  "title": "GetOutput",
  "type": "object"
}
